//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

// Hold-Tapの調整
&mt {
    tapping-term-ms = <100>;
};

// スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		// LCLK 19,20
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//RCLK 20,21
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		// MCLK 19,21
	    combo_MCLK {
            timeout-ms = <70>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

		// MB4 31,32
	    combo_MB4 {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mkp MB4>;
        };

		// MB5 32,33
	    combo_MB5 {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mkp MB5>;
        };

		// LANG1 15,16
	    combo_LANG1 {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LANG1>;
        };

		// LANG2 14,15
	    combo_LANG2 {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LANG2>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp ESC        &kp Q   &kp W  &kp E  &kp R  &kp T                &kp Y            &kp U  &kp I      &kp O    &kp P      &kp LGUI
            &kp TAB        &kp A   &kp S  &kp D  &kp F  &kp G                &kp H            &kp J  &kp K      &kp L    &kp MINUS  &kp LALT
            &kp LC(LS(S))  &kp Z   &kp X  &kp C  &kp V  &kp B                &kp N            &kp M  &kp COMMA  &kp DOT  &kp UNDER  &kp LA(LG(S))
            &kp K_UNDO     &kp K_REDO            &mo 1  &mt SPACE LCTRL      &mt ENTER LSHFT  &mo 2                      &kp BSPC   &kp DEL
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &trans  &trans  &trans    &kp UP    &trans     &trans      &trans      &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans  &trans
            &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans      &kp KP_DOT  &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans  &trans
            &trans  &trans  &trans    &trans    &trans     &trans      &kp KP_N0   &kp KP_N1  &kp KP_N2  &kp KP_N3  &trans  &trans
            &trans  &trans                      &trans     &trans      &trans      &trans                           &trans  &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans  &kp AT     &kp EXCL   &kp QMARK  &kp LT    &kp GT         &kp GRAVE  &kp LBRC  &kp RBRC  &kp HASH  &kp DLLR   &trans
            &trans  &kp FSLH   &kp STAR   &kp MINUS  &kp PLUS  &kp EQUAL      &kp DQT    &kp LPAR  &kp RPAR  &kp SEMI  &kp COLON  &trans
            &trans  &kp CARET  &kp TILDE  &kp PIPE   &kp AMPS  &kp PRCNT      &kp SQT    &kp LBKT  &kp RBKT  &kp FSLH  &kp BSLH   &trans
            &trans  &trans                           &trans    &trans         &trans     &trans                        &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &trans  &trans        &trans        &trans        &trans        &trans            &trans  &kp F7  &kp F8  &kp F9  &kp F10  &trans
            &trans  &trans        &trans        &trans        &trans        &trans            &trans  &kp F4  &kp F5  &kp F6  &kp F11  &trans
            &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans  &kp F1  &kp F2  &kp F3  &kp F12  &trans
            &trans  &trans                                    &trans        &trans            &trans  &out OUT_BLE            &trans  &trans
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
