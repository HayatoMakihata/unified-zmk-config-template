//スクロール量の調整(デフォルト150)
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
	behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整
&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/{
    combos {
        compatible = "zmk,combos";
		//左クリックのコンボ 19,20
	    combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

		//右クリックのコンボ 20,21
        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

		//ホイールクリックのコンボ 19,21
	    combo_MCLK {
            timeout-ms = <70>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };

		//MB4クリックのコンボ 31,32
	    combo_MB4 {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mkp MB4>;
        };

		//MB5クリックのコンボ 32,33
	    combo_MB5 {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mkp MB5>;
        };

    };
};

/{
keymap {
    compatible = "zmk,keymap";

    default_layer {
        bindings = <
            &kp ESC       &kp Q   &kp W  &kp E  &kp R  &kp T              &kp Y           &kp U  &kp I      &kp O    &kp P     &kp LGUI
            &kp TAB       &kp A   &kp S  &kp D  &kp F  &kp G              &kp H           &kp J  &kp K      &kp L    &kp MINUS &kp LALT
            &kp LC(LS(S)) &kp Z   &kp X  &kp C  &kp V  &kp B              &kp N           &kp M  &kp COMMA  &kp DOT  &kp UNDER &kp LA(LG(S))
            &kp K_UNDO    &kp K_REDO            &mo 2  &mt SPACE LCTRL    &mt ENTER LSHFT &mo 1                      &kp BSPC  &kp DEL
        >;
		//&ec_ms_lとrは、上のビヘイビアで作ったもの。
        sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
    };
	
    layer_1 {
        bindings = <
            &trans &trans &trans   &kp UP   &trans    &trans      &trans    &kp KP_N7 &kp KP_N8 &kp KP_N9 &trans &trans
            &trans &trans &kp LEFT &kp DOWN &kp RIGHT &trans      &trans    &kp KP_N4 &kp KP_N5 &kp KP_N6 &trans &trans
            &trans &trans &trans   &trans   &trans    &trans      &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &trans &trans
            &trans &trans                   &trans    &trans      &trans    &trans                        &trans &trans
        >;
    };

    layer_2 {
        bindings = <
            &trans &kp F1  &kp F2  &kp F3  &kp F4  &kp F5     &trans  &trans    &kp MINUS &kp EQUAL &trans     &trans
            &trans &kp F6  &kp F7  &kp F8  &kp F9  &kp F10    &trans  &kp LBKT  &kp RBKT  &kp NUBS  &trans     &trans
            &trans &kp F11 &kp F12 &kp F13 &kp F14 &kp F15    &trans  &kp SEMI  &kp SQT   &trans    &kp QMARK  &kp BSLH
            &trans &trans                  &trans  &trans     &trans  &trans                        &trans     &trans
        >;
		//レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
		sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;

    };

    layer_3 {
        bindings = <
            &trans &trans &trans &trans &trans &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3   &bt BT_SEL 4
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &trans         &trans
            &trans &trans &trans &trans &trans &trans      &trans  &trans        &trans        &trans        &bt BT_CLR_ALL &bt BT_CLR
            &trans &trans               &trans &trans      &trans  &out OUT_BLE                                    &trans         &trans
        >;
    };
    scroll {
        status = "reserved";
    };

    extra2 {
        status = "reserved";
    };
};
};
